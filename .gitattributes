# Normalise all text files to LF on commit and checkout.
# Prevents CRLF/LF noise on Windows with core.autocrlf=true.
* text=auto eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.pdf  binary
*.zip  binary
